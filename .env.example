# Reference values for local development. The Go server reads process
# environment variables directly; it does not load .env files automatically.

# HTTP port for the Go API server
PORT=8080

# PostgreSQL connection string used by the server (applies migrations on start).
# Replace USER and PASSWORD with your local PostgreSQL credentials.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/depot?sslmode=disable

# Integration tests require this dedicated disposable database (its tables are
# truncated between tests). The database name must end in _test. There is no
# implicit test-database default when this variable is unset.
DEPOT_TEST_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/depot_test?sslmode=disable

# Browser origins allowed to call the API (comma-separated; matches the Vite
# dev server, which falls back to the next port when 5173 is taken)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Docker Compose PostgreSQL credentials (development only; change before
# exposing the database outside your machine).
POSTGRES_USER=depot
POSTGRES_PASSWORD=depot
POSTGRES_DB=depot
